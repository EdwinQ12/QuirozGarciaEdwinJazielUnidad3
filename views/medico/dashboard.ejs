<%- include('../partials/header', { titulo: 'Panel de médico' }) %>

<body class="d-flex flex-column min-vh-100">

<%- include('../partials/navbar') %>

<main class="flex-grow-1">

    <div class="container mt-5">

        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">

            <div>
                <h1 class="text-primary mb-1">Panel de médico</h1>
                <p class="text-muted mb-0">
                    <%= nombre %> · <%= correo %>
                </p>
            </div>

            <a href="/chat" class="btn btn-outline-primary">
                <i class="fa-solid fa-comments me-2" aria-hidden="true"></i>
                Comentarios
            </a>

        </div>

        <div class="card shadow-sm">

            <div class="card-body">

                <h5 class="mb-3">Citas pendientes y confirmadas</h5>

                <% if (citas.length === 0) { %>

                    <p class="text-muted mb-0">
                        No hay citas pendientes por atender.
                    </p>

                <% } else { %>

                    <div class="table-responsive">

                        <table class="table align-middle tabla-citas mb-0">

                            <thead>
                                <tr>
                                    <th scope="col">Fecha</th>
                                    <th scope="col">Paciente</th>
                                    <th scope="col">Especialista</th>
                                    <th scope="col">Motivo</th>
                                    <th scope="col">Estado</th>
                                    <th scope="col" class="text-end">Acciones</th>
                                </tr>
                            </thead>

                            <tbody>

                                <% citas.forEach(function (c) { %>

                                    <tr>
                                        <td class="text-nowrap">
                                            <%= c.fecha %>
                                            <span class="text-muted small d-block"><%= c.hora %> hrs</span>
                                        </td>

                                        <td><%= c.paciente %></td>

                                        <td class="small"><%= c.especialista %></td>

                                        <td class="small motivo-celda"><%= c.motivo %></td>

                                        <td>
                                            <%- include('../partials/badge-estado', { estado: c.estado }) %>
                                        </td>

                                        <td class="text-end text-nowrap">

                                            <form action="/citas/<%= c.id %>/estado" method="POST" class="d-inline-flex gap-1">

                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                                                <% if (c.estado === 'pendiente') { %>
                                                    <button name="estado" value="confirmada" class="btn btn-sm btn-outline-primary">
                                                        Confirmar
                                                    </button>
                                                <% } %>

                                                <button name="estado" value="atendida" class="btn btn-sm btn-outline-success">
                                                    Atender
                                                </button>

                                                <button name="estado" value="cancelada" class="btn btn-sm btn-outline-danger">
                                                    Cancelar
                                                </button>

                                            </form>

                                        </td>
                                    </tr>

                                <% }); %>

                            </tbody>

                        </table>

                    </div>

                <% } %>

            </div>

        </div>

    </div>

</main>

<%- include('../partials/alerts') %>

<%- include('../partials/footer') %>

</body>
</html>
