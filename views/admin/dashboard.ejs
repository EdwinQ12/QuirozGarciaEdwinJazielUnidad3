<%- include('../partials/header', { titulo: 'Panel de administrador' }) %>

<body class="d-flex flex-column min-vh-100">

<%- include('../partials/navbar') %>

<main class="flex-grow-1">

    <div class="container mt-5">

        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">

            <div>
                <h1 class="text-primary mb-1">Panel de administrador</h1>
                <p class="text-muted mb-0"><%= nombre %> · <%= correo %></p>
            </div>

            <div class="d-flex gap-2">

                <a href="/buzon" class="btn btn-outline-primary">
                    <i class="fa-solid fa-envelope me-2" aria-hidden="true"></i>
                    Buzón
                </a>

                <a href="/chat" class="btn btn-outline-primary">
                    <i class="fa-solid fa-comments me-2" aria-hidden="true"></i>
                    Comentarios
                </a>

            </div>

        </div>

        <!-- Estadísticas -->
        <div class="row g-3 mb-4">

            <div class="col-6 col-lg-3">
                <div class="card shadow-sm h-100 tarjeta-resumen">
                    <div class="card-body">
                        <span class="resumen-icono" aria-hidden="true">👥</span>
                        <h6 class="text-muted mb-1">Usuarios</h6>
                        <h3 class="mb-0"><%= stats.usuarios %></h3>
                    </div>
                </div>
            </div>

            <div class="col-6 col-lg-3">
                <div class="card shadow-sm h-100 tarjeta-resumen">
                    <div class="card-body">
                        <span class="resumen-icono" aria-hidden="true">📅</span>
                        <h6 class="text-muted mb-1">Citas totales</h6>
                        <h3 class="mb-0"><%= stats.citas %></h3>
                    </div>
                </div>
            </div>

            <div class="col-6 col-lg-3">
                <div class="card shadow-sm h-100 tarjeta-resumen">
                    <div class="card-body">
                        <span class="resumen-icono" aria-hidden="true">⏳</span>
                        <h6 class="text-muted mb-1">Pendientes</h6>
                        <h3 class="mb-0"><%= stats.pendientes %></h3>
                    </div>
                </div>
            </div>

            <div class="col-6 col-lg-3">
                <div class="card shadow-sm h-100 tarjeta-resumen">
                    <div class="card-body">
                        <span class="resumen-icono" aria-hidden="true">📨</span>
                        <h6 class="text-muted mb-1">Mensajes</h6>
                        <h3 class="mb-0"><%= stats.mensajes %></h3>
                    </div>
                </div>
            </div>

        </div>

        <!-- Últimas citas -->
        <div class="card shadow-sm">

            <div class="card-body">

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="mb-0">Últimas citas</h5>
                    <span class="text-muted small">
                        Hoy: <%= stats.hoy %> cita(s)
                    </span>
                </div>

                <% if (citas.length === 0) { %>

                    <p class="text-muted mb-0">Todavía no hay citas registradas.</p>

                <% } else { %>

                    <div class="table-responsive">

                        <table class="table align-middle tabla-citas mb-0">

                            <thead>
                                <tr>
                                    <th scope="col">Fecha</th>
                                    <th scope="col">Paciente</th>
                                    <th scope="col">Especialista</th>
                                    <th scope="col">Estado</th>
                                    <th scope="col" class="text-end">Acciones</th>
                                </tr>
                            </thead>

                            <tbody>

                                <% citas.forEach(function (c) { %>

                                    <tr>
                                        <td class="text-nowrap">
                                            <%= c.fecha %>
                                            <span class="text-muted small d-block"><%= c.hora %> hrs</span>
                                        </td>

                                        <td><%= c.paciente %></td>
                                        <td class="small"><%= c.especialista %></td>

                                        <td>
                                            <%- include('../partials/badge-estado', { estado: c.estado }) %>
                                        </td>

                                        <td class="text-end text-nowrap">

                                            <form action="/citas/<%= c.id %>/estado" method="POST" class="d-inline-flex gap-1">

                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                                                <% if (c.estado === 'pendiente') { %>
                                                    <button name="estado" value="confirmada" class="btn btn-sm btn-outline-primary">
                                                        Confirmar
                                                    </button>
                                                <% } %>

                                                <% if (c.estado === 'confirmada') { %>
                                                    <button name="estado" value="atendida" class="btn btn-sm btn-outline-success">
                                                        Atender
                                                    </button>
                                                <% } %>

                                                <% if (c.estado === 'pendiente' || c.estado === 'confirmada') { %>
                                                    <button name="estado" value="cancelada" class="btn btn-sm btn-outline-danger">
                                                        Cancelar
                                                    </button>
                                                <% } %>

                                            </form>

                                        </td>
                                    </tr>

                                <% }); %>

                            </tbody>

                        </table>

                    </div>

                <% } %>

            </div>

        </div>

    </div>

</main>

<%- include('../partials/alerts') %>

<%- include('../partials/footer') %>

</body>
</html>
