<%- include('partials/header', { titulo: 'Registro' }) %>

<body class="d-flex flex-column min-vh-100">

<%- include('partials/navbar') %>

<main class="flex-grow-1">

    <div class="container mt-5 animate__animated animate__fadeInLeft">

        <div class="card p-4 shadow-sm evento-cards">

            <h2 class="text-success mb-4">Registro</h2>

            <form action="/registro" method="POST">

                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                <div class="mb-3">
                    <label class="form-label">Nombre completo</label>
                    <input
                        type="text"
                        name="nombre"
                        class="form-control"
                        required>
                </div>

                <div class="mb-3">
                    <label class="form-label">Correo</label>
                    <input
                        type="email"
                        name="correo"
                        class="form-control"
                        required>
                </div>

                <div class="mb-3">
                    <label class="form-label">Contraseña</label>
                    <input
                        type="password"
                        name="password"
                        class="form-control"
                        minlength="8"
                        required>
                </div>

                <% if (siteKey) { %>
                <div class="mb-3">
                    <div class="g-recaptcha" data-sitekey="<%= siteKey %>"></div>
                </div>
                <% } else { %>
                <div class="alert alert-warning">
                    Falta configurar <code>RECAPTCHA_SITE_KEY</code> en el archivo <code>.env</code>.
                </div>
                <% } %>

                <button type="submit" class="btn btn-success">
                    Registrar Usuario
                </button>

                <a href="/" class="btn btn-secondary">
                    Volver
                </a>

            </form>

        </div>

    </div>

</main>

<%- include('partials/alerts') %>

<%- include('partials/footer') %>

<% if (siteKey) { %>
<script src="https://www.google.com/recaptcha/api.js" async defer></script>
<% } %>

</body>
</html>