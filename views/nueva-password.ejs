<%- include('partials/header') %>

<body class="d-flex flex-column min-vh-100">

<%- include('partials/navbar') %>

<main class="flex-grow-1">

    <div class="container mt-5 animate__animated animate__fadeInLeft">

        <div class="card shadow p-4 evento-cards">

            <h2 class="mb-4 text-success">
                Nueva Contraseña
            </h2>

            <form action="/nueva-password" method="POST">

                <input
                    type="hidden"
                    name="correo"
                    value="<%= correo %>">

                <div class="mb-3">

                    <label class="form-label">
                        Nueva contraseña
                    </label>

                    <input
                        type="password"
                        name="password"
                        class="form-control"
                        minlength="8"
                        required>

                </div>

                <button
                    type="submit"
                    class="btn btn-success">

                    Actualizar Contraseña

                </button>

            </form>

        </div>

    </div>

</main>

<%- include('partials/alerts') %>
<%- include('partials/footer') %>

</body>
</html>