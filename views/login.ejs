<%- include('partials/header', { titulo: 'Login' }) %>

<body class="d-flex flex-column min-vh-100">

<%- include('partials/navbar') %>

<main class="flex-grow-1">

    <div class="container mt-5 animate__animated animate__fadeInLeft">

        <div class="card p-4 shadow-sm evento-cards">

            <h2 class="text-success mb-4">
                Login
            </h2>

            <form action="/login" method="POST">

                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                <div class="mb-3">

                    <label class="form-label">
                        Correo
                    </label>

                    <input
                        type="email"
                        name="correo"
                        class="form-control"
                        required>

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Contraseña
                    </label>

                    <input
                        type="password"
                        name="password"
                        class="form-control"
                        required>

                </div>

                <button
                    type="submit"
                    class="btn btn-success">
                    Iniciar Sesión
                </button>

                <a href="/" class="btn btn-secondary">
                    Volver
                </a>

                <div class="mt-3">
                    <a href="/recuperar">
                        ¿Olvidaste tu contraseña?
                    </a>
                </div>

            </form>

        </div>

    </div>

</main>

<%- include('partials/alerts') %>
<%- include('partials/footer') %>

</body>
</html>