# ==========================================================
#  Copia este archivo como `.env` y completa los valores.
#  El archivo `.env` NO se sube al repositorio.
# ==========================================================

# Puerto del servidor (opcional, por defecto 3000)
PORT=3000

# "production" activa cookies seguras y silencia logs sensibles.
NODE_ENV=development

# --- Sesión ---
# Cadena larga y aleatoria. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=cambia-esta-cadena-por-una-aleatoria

# --- Base de datos PostgreSQL ---
DB_HOST=localhost
DB_PUERTO=5432
DB_NOMBRE=rayito_de_sol
DB_USUARIO=postgres
DB_PASSWORD=tu_password

# --- reCAPTCHA v2 de Google ---
# Se obtienen en https://www.google.com/recaptcha/admin
RECAPTCHA_SITE_KEY=tu_site_key
RECAPTCHA_SECRET_KEY=tu_secret_key

# --- Correo saliente (opcional) ---
# Si se deja vacío, el enlace de recuperación se imprime en la consola.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
